# Account Management Service — environment variables.
# Copy to .env and fill in values. NEVER commit .env.

# HTTP port the service listens on (default: 3000)
PORT=3000
NODE_ENV=development

# REQUIRED. PostgreSQL connection string, e.g. postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=
# Use TLS for the PostgreSQL connection (default: false)
DATABASE_SSL=false
# Maximum number of pooled PostgreSQL connections (default: 10)
DATABASE_POOL_MAX=10
# Milliseconds to wait for a PostgreSQL connection before failing (default: 5000)
DATABASE_CONNECTION_TIMEOUT_MS=5000
