# ─── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ─── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=user_management
DB_USER=postgres
DB_PASSWORD=changeme
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ─── OTP ──────────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=15
OTP_LENGTH=6

# ─── Email / SMTP ─────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=changeme
EMAIL_FROM="User Management <no-reply@example.com>"

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
